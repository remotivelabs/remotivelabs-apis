          "public": {
            "$ref": "#/definitions/public"
          },
          "sub_type": {
            "$ref": "#/definitions/sub_type"
          },
          "sub_type_b": {
            "$ref": "#/definitions/sub_type_b"
          },
          "database_config": {
            "$ref": "#/definitions/database_config"
          },
          "topology_info": {
            "$ref": "#/definitions/topology_info"
          }
        },
        "allOf": [
