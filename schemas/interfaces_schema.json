    "time_stamp": {
      "description": "Where a received frame's time stamp comes from: the host's clock when the frame is read, or the interface's hardware.",
      "default": "software",
      "enum": [
        "software",
        "hardware"
      ]
    },
    "sub_type": {
      "description": "How frames are laid out in a UDP packet. Left out: a 4-byte identifier and a 1-byte length before each frame, as RemotiveBrokers send CAN to each other. `pdu`: a 4-byte identifier and a 4-byte length before each PDU, as an ethernet channel carries them. An integer selects the MRCOM framing, with `sub_type_b`.",
      "oneOf": [
        {
          "const": "pdu"
        },
        {
          "type": "integer"
        }
      ]
    },
    "sub_type_b": {
      "description": "The second MRCOM framing parameter, read only when `sub_type` is an integer.",
      "default": 0,
      "type": "integer"
    },
    "fixed_payload_size": {
      "description": "Payload size in bytes every frame is padded or cut to, overriding the database. 0 keeps the database's sizes.",
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "topology_info": {
      "description": "What a RemotiveTopology build says about the namespace: the channel it is on and whose view of it it is. Written by the build, not by hand.",
      "type": "object",
      "properties": {
        "namespace_kind": {
          "description": "Whose view of the channel the namespace is: an ECU's, the topology broker's, or a tap's copy of another namespace.",
          "enum": [
            "ecu",
            "topology",
            "tap"
          ]
        },
        "channel_type": {
          "description": "The kind of the channel the namespace is on.",
          "enum": [
            "can",
            "lin",
            "ethernet",
            "flexray"
          ]
        },
        "channel_name": {
          "description": "The channel, by its name in the platform.",
          "type": "string"
        },
        "ecu_name": {
          "description": "The ECU whose view this is, for an `ecu` namespace.",
          "type": "string"
        },
        "can_cluster": {
          "description": "The CAN cluster the channel belongs to, on a CAN channel.",
          "type": "string"
        },
        "can_physical_channel_name": {
          "description": "The channel's physical channel in the signal database, on a CAN channel.",
          "type": "string"
        },
        "socket": {
          "description": "The ECU's own socket of the socket pair, on an ethernet PDU namespace.",
          "type": "string"
        },
        "remote_socket": {
          "description": "The other end of the socket pair, on an ethernet PDU namespace.",
          "type": "string"
        },
        "sent_pdus": {
          "description": "The PDUs the ECU sends over the socket pair, on an ethernet PDU namespace.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "namespace_kind",
        "channel_type",
        "channel_name"
      ],
      "if": {
        "properties": {
          "namespace_kind": {
            "const": "ecu"
          }
        }
      },
      "then": {
        "required": [
          "ecu_name"
        ]
      }
    },
    "database_config": {
      "description": "Which part of the signal database the namespace reads, told apart by `type`.",
      "oneOf": [
        {
          "title": "CAN",
          "description": "A CAN channel of the signal database.",
          "type": "object",
          "properties": {
            "type": {
              "const": "can"
            },
            "channel_name": {
              "description": "The channel in the signal database, where it describes more than one.",
              "type": "string"
            },
            "can_physical_channel_name": {
              "description": "The physical channel in the signal database, for an AUTOSAR extract. Deprecated: name the channel with `channel_name`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "title": "LIN",
          "description": "A LIN channel of the signal database.",
          "type": "object",
          "properties": {
            "type": {
              "const": "lin"
            },
            "channel_name": {
              "description": "The channel in the signal database, where it describes more than one.",
              "type": "string"
            },
            "lin_physical_channel_name": {
              "description": "The physical channel in the signal database. Deprecated: name the channel with `channel_name`.",
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "title": "LIN over UDP",
          "description": "A LIN channel of the signal database, read as a CAN channel is.",
          "type": "object",
          "properties": {
            "type": {
              "const": "udp-lin"
            },
            "channel_name": {
              "description": "The channel in the signal database, where it describes more than one.",
              "type": "string"
            },
            "can_physical_channel_name": {
              "description": "The physical channel in the signal database, for an AUTOSAR extract. Deprecated: name the channel with `channel_name`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "title": "FlexRay",
          "description": "A FlexRay channel of the signal database.",
          "type": "object",
          "properties": {
            "type": {
              "const": "flexray"
            },
            "channel_name": {
              "description": "The channel in the signal database, where it describes more than one.",
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "title": "Ethernet PDUs",
          "description": "The PDUs of an ethernet channel of an AUTOSAR extract that one socket pair carries.",
          "type": "object",
          "properties": {
            "type": {
              "const": "ethernet_pdu"
            },
            "channel_name": {
              "description": "The channel in the signal database, where it describes more than one.",
              "type": "string"
            },
            "local_host": {
              "description": "The namespace's own socket address, to pick the PDUs sent from it.",
              "type": "string"
            },
            "local_port": {
              "description": "The namespace's own socket port.",
              "type": "integer"
            },
            "remote_host": {
              "description": "The other end's socket address.",
              "type": "string"
            },
            "remote_port": {
              "description": "The other end's socket port.",
              "type": "integer"
            },
            "target_as_local": {
              "description": "Take the chain's target as the local socket instead. Not together with the local and remote fields.",
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "if": {
            "properties": {
              "target_as_local": {
                "const": true
              }
            },
            "required": [
              "target_as_local"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "local_host"
                  ]
                },
                {
                  "required": [
                    "local_port"
                  ]
                },
                {
                  "required": [
                    "remote_host"
                  ]
                },
                {
                  "required": [
                    "remote_port"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
