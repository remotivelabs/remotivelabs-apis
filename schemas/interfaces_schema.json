{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://files.remotivelabs.com/schemas/interfaces-1.0.schema.json",
  "type": "object",
  "title": "RemotiveBroker configuration",
  "description": "JSON configuration file for RemotiveBroker. The configuration file must be named `interfaces.json` and all paths in the configuration are relative paths to this file.\nConfigures all interfaces that the broker will operate on.",
  "properties": {
    "chains": {
      "description": "List of configured interfaces available to RemotiveBroker.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/namespaces/virtual"
          },
          {
            "$ref": "#/definitions/namespaces/scripted"
          },
          {
            "$ref": "#/definitions/namespaces/can"
          },
          {
            "$ref": "#/definitions/namespaces/can_fd"
          },
          {
            "$ref": "#/definitions/namespaces/udp"
          },
          {
            "$ref": "#/definitions/namespaces/some_ip"
          },
          {
            "$ref": "#/definitions/namespaces/lin"
          },
          {
            "$ref": "#/definitions/namespaces/lin_udp"
          },
          {
            "$ref": "#/definitions/namespaces/flexray"
          },
          {
            "$ref": "#/definitions/namespaces/tap"
          }
        ]
      },
      "type": "array"
    },
    "grpc_server": {
      "description": "Configuration for built-in gRPC server. Documentation for available service is available on <https://developer.remotivelabs.com>.",
      "properties": {
        "port": {
          "description": "Server port for gRPC server.",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "port"
      ],
      "type": "object"
    },
    "reflectors": {
      "description": "A list of reflector configurations.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reflect": {
            "description": "Configure reflectors to always bounce traffic.",
            "type": "array",
            "items": {
              "description": "Bounce mechanism, with a _source_ and a _destination_.",
              "type": "object",
              "properties": {
                "source": {
                  "description": "Name of source namespace.",
                  "type": "string"
                },
                "dest": {
                  "description": "Name of destination namespace.",
                  "type": "string"
                },
                "exclude": {
                  "description": "List of frames to exclude in reflector.",
                  "type": "array",
                  "items": {
                    "description": "Name of frame to exclude",
                    "type": "string"
                  }
                }
              },
              "required": [
                "source",
                "dest"
              ]
            }
          }
        },
        "required": [
          "reflect"
        ]
      }
    },
    "master_node": {
      "description": "The broker node to connect to and register this broker's namespaces with, as `name@host`. A RemotiveTopology build points every ECU's broker at the topology broker.",
      "type": "string"
    },
    "rest_server": {
      "description": "Configuration for the built-in REST server.",
      "type": "object",
      "properties": {
        "port": {
          "description": "Server port for the REST server.",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "port"
      ]
    },
    "channels": {
      "description": "Not read. A RemotiveTopology build writes it empty.",
      "type": "array",
      "maxItems": 0
    },
    "nodes": {
      "description": "Not supported. A file that listed several brokers under `nodes` is refused; give each broker its own interfaces.json, with `master_node` naming the broker it joins."
    }
  },
  "required": [
    "chains"
  ],
  "not": {
    "required": [
      "nodes"
    ]
  },
  "definitions": {
    "auto_recover": {
      "default": true,
      "description": "Monitor CAN interfaces for state changes to error passive and reset upon detection. Note: Using virtual CAN devices will not support the built-in automatic recovery for CAN devices that enter passive mode. If automatic recovery mode is enabled for a virtual device, the server will issue a warning each time it attempts to retrieve the device's state.",
      "type": "boolean"
    },
    "brs": {
      "default": false,
      "description": "CAN FD BRS (Bit Rate Switching)",
      "type": "boolean"
    },
    "database_restrictions": {
      "oneOf": [
        {
          "required": [
            "database"
          ],
          "not": {
            "required": [
              "databases"
            ]
          }
        },
        {
          "required": [
            "databases"
          ],
          "not": {
            "required": [
              "database"
            ]
          }
        }
      ]
    },
    "host": {
      "description": "Network address accepted by the OS. Eg. Ipv4: `127.0.0.1`.",
      "format": "ipv4",
      "type": "string"
    },
    "namespace": {
      "description": "Name assigned to device, used in signal operations.",
      "type": "string"
    },
    "port": {
      "description": "Networking port",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "short_names": {
      "default": true,
      "description": "Have signals addressable in the RemotiveBroker by their name in the database.\nIf `false`, signal names will be generated based on their respective namespace.",
      "type": "boolean"
    },
    "signal_db": {
      "description": "Path to signal database.",
      "type": "string"
    },
    "can_physical_channel_name": {
      "type": "string",
      "description": "This property is required when using an arxml database. Path to the physical channel that should be used. Referenced by SHORT-NAME element, e.g. /Topology/Name/ID"
    },
    "public": {
      "description": "Configure the interface to be public or private, default is public. Private namespaces are not exposed by the broker. This is useful for example when working with scripted VSS signals and you don't want the designer to see the internal vehicle signals.",
      "type": "boolean",
      "default": true
    },
    "some_ip_service": {
      "description": "Service definition for SOME/IP.",
      "type": "object",
      "properties": {
        "service_id": {
          "description": "Unique service identifier.",
          "type": "integer",
          "maximum": 65535,
          "minimum": 0
        },
        "instance_id": {
          "description": "Service instance identifier.",
          "type": "integer",
          "maximum": 65535,
          "minimum": 0
        },
        "version_major": {
          "description": "Major version number.",
          "type": "integer",
          "maximum": 255,
          "minimum": 0
        },
        "version_minor": {
          "description": "Minor version of the service interface.",
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "event_group_ids": {
          "description": "The event groups to subscribe to. Left out, the broker subscribes to event group 0xFFFF; an empty list subscribes to none.",
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 65535,
            "type": "integer"
          }
        }
      },
      "required": [
        "service_id",
        "instance_id",
        "version_major"
      ]
    },
    "namespaces": {
      "virtual": {
        "description": "Virtual signaling interface. This device doesn't use a database, any published signals will be sent to subscribers of the given signal.",
        "properties": {
          "namespace": {
            "$ref": "#/definitions/namespace"
          },
          "type": {
            "description": "Specifies a virtual interface.",
            "default": "virtual",
            "enum": [
              "virtual"
            ]
          },
          "public": {
            "$ref": "#/definitions/public"
          },
          "topology_info": {
            "$ref": "#/definitions/topology_info"
          }
        },
        "required": [
          "namespace",
          "type"
        ],
        "title": "Virtual",
        "type": "object"
      },
      "scripted": {
        "title": "Scripted",
        "description": "Scripted signals",
        "type": "object",
        "properties": {
          "namespace": {
            "$ref": "#/definitions/namespace"
          },
          "type": {
            "description": "Specifies a scripted interface.",
            "default": "scripted",
            "enum": [
              "scripted"
            ]
          },
          "database": {
            "$ref": "#/definitions/signal_db",
            "description": "Path to a scripted database"
          },
          "databases": {
            "description": "Path to a scripted database",
            "type": "array",
            "items": {
              "$ref": "#/definitions/signal_db"
            }
          },
          "public": {
            "$ref": "#/definitions/public"
          }
        },
        "allOf": [
          {
            "$ref": "#/definitions/database_restrictions"
          }
        ],
        "required": [
          "namespace",
          "type"
        ]
      },
      "can": {
        "description": "CAN interface.",
        "properties": {
          "database": {
            "$ref": "#/definitions/signal_db",
            "description": "Path to signal database file. Supporting .dbc and .arxml. When using an arxml database, can_physical_channel_name must be specified."
          },
          "databases": {
            "description": "Path to signal database file. Supporting .dbc and .arxml. When using an arxml database, can_physical_channel_name must be specified.",
            "type": "array",
            "items": {
              "$ref": "#/definitions/signal_db"
            }
          },
          "can_physical_channel_name": {
            "$ref": "#/definitions/can_physical_channel_name"
          },
          "device_name": {
            "description": "Name of device in OS.",
            "type": "string"
          },
          "namespace": {
            "$ref": "#/definitions/namespace"
          },
          "short_names": {
            "$ref": "#/definitions/short_names"
          },
          "type": {
            "description": "Specifies a CAN interface.",
            "default": "can",
            "enum": [
              "can"
            ]
          },
          "baud_rate": {
            "description": "The interface's baud rate, in bits per second, set when the broker starts it.",
            "type": "integer"
          },
          "public": {
            "$ref": "#/definitions/public"
          },
          "auto_recover": {
            "$ref": "#/definitions/auto_recover"
          },
          "time_stamp": {
            "$ref": "#/definitions/time_stamp"
          },
          "database_config": {
            "$ref": "#/definitions/database_config"
          },
          "fixed_payload_size": {
            "$ref": "#/definitions/fixed_payload_size"
          },
          "topology_info": {
            "$ref": "#/definitions/topology_info"
          },
          "brs": {
            "$ref": "#/definitions/brs"
          },
          "dbaud_rate": {
            "description": "The baud rate of CAN FD's data phase, in bits per second, set when the broker starts the interface.",
            "type": "integer"
          }
        },
        "allOf": [
          {
            "$ref": "#/definitions/database_restrictions"
          }
        ],
        "required": [
          "type",
          "namespace",
          "device_name"
        ],
        "title": "CAN",
        "type": "object"
      },
      "can_fd": {
        "description": "CAN-FD interface.",
        "properties": {
          "database": {
            "$ref": "#/definitions/signal_db",
            "description": "Path to signal database file. Supporting .dbc and .arxml. When using an arxml database, can_physical_channel_name must be specified."
          },
          "databases": {
            "description": "Path to signal database file. Supporting .dbc and .arxml. When using an arxml database, can_physical_channel_name must be specified.",
            "type": "array",
            "items": {
              "$ref": "#/definitions/signal_db"
            }
          },
          "can_physical_channel_name": {
            "$ref": "#/definitions/can_physical_channel_name"
          },
          "device_name": {
            "description": "Name of device in OS.",
            "type": "string"
          },
          "namespace": {
            "$ref": "#/definitions/namespace"
          },
          "short_names": {
            "$ref": "#/definitions/short_names"
          },
          "type": {
            "description": "Specifies a CAN-FD interface.",
            "default": "canfd",
            "enum": [
              "canfd"
            ]
          },
          "baud_rate": {
            "description": "The interface's baud rate, in bits per second, set when the broker starts it. Set together with `dbaud_rate`: a CAN FD device takes both or neither.",
            "type": "integer"
          },
          "dbaud_rate": {
            "description": "The baud rate of CAN FD's data phase, in bits per second, set when the broker starts the interface. Set together with `baud_rate`.",
            "type": "integer"
          },
          "public": {
            "$ref": "#/definitions/public"
          },
          "auto_recover": {
            "$ref": "#/definitions/auto_recover"
          },
          "brs": {
            "$ref": "#/definitions/brs"
          },
          "time_stamp": {
            "$ref": "#/definitions/time_stamp"
          },
          "database_config": {
            "$ref": "#/definitions/database_config"
          },
          "fixed_payload_size": {
            "$ref": "#/definitions/fixed_payload_size"
          },
          "topology_info": {
            "$ref": "#/definitions/topology_info"
          }
        },
        "dependencies": {
          "baud_rate": [
            "dbaud_rate"
          ],
          "dbaud_rate": [
            "baud_rate"
          ]
        },
        "allOf": [
          {
            "$ref": "#/definitions/database_restrictions"
          }
        ],
        "required": [
          "type",
          "namespace",
          "device_name"
        ],
        "title": "CAN-FD",
        "type": "object"
      },
      "some_ip": {
        "description": "SOME/IP interface configuration.",
        "title": "SOME/IP",
        "type": "object",
        "properties": {
          "namespace": {
            "$ref": "#/definitions/namespace"
          },
          "database": {
            "$ref": "#/definitions/signal_db",
            "description": "Path to signal database file. Supporting .xml and .arxml. When using an arxml database"
          },
          "databases": {
            "description": "Path to signal database file. Supporting .xml and .arxml. When using an arxml database",
            "type": "array",
            "items": {
              "$ref": "#/definitions/signal_db"
            }
          },
          "type": {
            "description": "Specifies a SOME/IP interface.",
            "default": "someip",
            "enum": [
              "someip"
            ]
          },
          "services": {
            "description": "The ids of the services to read from the database, which makes reading it faster. Left out, every service is read; an empty list reads none.",
            "type": "array",
            "items": {
              "type": "integer",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "service_discovery": {
            "description": "Configuration for SOME/IP service discovery.",
            "type": "object",
            "properties": {
              "multicast_group_ip": {
                "description": "Multicast group IP for discovery.",
                "$ref": "#/definitions/host"
              },
              "server_host": {
                "$ref": "#/definitions/host",
                "default": "0.0.0.0"
              },
              "server_port": {
                "description": "Port number for discovery.",
                "$ref": "#/definitions/port",
                "default": 30490
              },
              "subscribe_retry_delay": {
                "description": "Milliseconds to wait before subscribing again to a service that did not answer.",
                "default": 5000,
                "minimum": 0,
                "type": "integer"
              }
            },
            "default": {
              "multicast_group_ip": "224.0.55.55",
              "server_host": "0.0.0.0",
              "server_port": 30490
            }
          },
          "endpoints": {
            "description": "List of SOME/IP endpoints.",
            "type": "array",
            "items": {
              "description": "SOME/IP endpoint configuration.",
              "type": "object",
              "properties": {
                "mode": {
                  "description": "Transport protocol",
                  "enum": [
                    "udp",
                    "tcp"
                  ]
                },
                "server_host": {
                  "default": "0.0.0.0",
                  "$ref": "#/definitions/host"
                },
                "server_port": {
                  "$ref": "#/definitions/port"
                },
                "service_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/some_ip_service"
                  }
                },
                "static_remotes": {
                  "description": "List of static remote services that this endpoint consumes.",
                  "type": "array",
                  "items": {
                    "description": "Static remote configuration for SOME/IP services.",
                    "type": "object",
                    "properties": {
                      "host": {
                        "$ref": "#/definitions/host"
                      },
                      "port": {
                        "$ref": "#/definitions/port"
                      },
                      "service_ids": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/some_ip_service"
                        }
                      },
                      "discovery_port": {
                        "description": "Discovery port.",
                        "default": 30490,
                        "$ref": "#/definitions/port"
                      }
                    },
                    "required": [
                      "host",
                      "port"
                    ]
                  }
                }
              },
              "required": [
                "mode",
                "server_port"
              ]
            }
          },
          "public": {
            "$ref": "#/definitions/public"
          },
          "short_names": {
            "$ref": "#/definitions/short_names"
          },
          "topology_info": {
            "$ref": "#/definitions/topology_info"
          }
        },
        "allOf": [
          {
            "$ref": "#/definitions/database_restrictions"
          }
        ],
        "required": [
          "namespace",
          "type",
          "endpoints"
        ]
      },
      "lin": {
        "title": "LIN",
        "description": "LIN on a socketcan device.",
        "type": "object",
        "properties": {
          "namespace": {
            "$ref": "#/definitions/namespace"
          },
          "type": {
            "description": "Specifies a LIN interface.",
            "default": "lin",
            "enum": [
              "lin"
            ]
          },
          "database": {
            "$ref": "#/definitions/signal_db",
            "description": "Path to the LIN signal database."
          },
          "databases": {
            "description": "Paths to LIN signal databases.",
            "type": "array",
            "items": {
              "$ref": "#/definitions/signal_db"
            }
          },
          "device_name": {
            "description": "Name of the socketcan device in the OS.",
            "type": "string"
          },
          "node_mode": {
            "description": "Type of LIN node.",
            "enum": [
              "master",
              "slave"
            ]
          },
          "schedule_autostart": {
            "description": "Not read: a master runs its schedule from the start.",
            "type": "boolean"
          },
          "schedule_file": {
            "description": "Path to `.ldf` file used for schedules.",
            "type": "string"
          },
          "schedule_table_name": {
            "description": "Name of the schedule table to run, as defined in the schedule `.ldf` file.",
            "type": "string"
          },
          "short_names": {
            "$ref": "#/definitions/short_names"
          },
          "public": {
            "$ref": "#/definitions/public"
          },
          "auto_recover": {
            "$ref": "#/definitions/auto_recover"
          },
          "brs": {
            "$ref": "#/definitions/brs"
          },
          "time_stamp": {
            "$ref": "#/definitions/time_stamp"
          },
          "baud_rate": {
            "description": "The interface's baud rate, in bits per second, set when the broker starts it.",
            "type": "integer"
          },
          "dbaud_rate": {
            "description": "The baud rate of CAN FD's data phase, in bits per second, set when the broker starts the interface.",
            "type": "integer"
          },
          "database_config": {
            "$ref": "#/definitions/database_config"
          },
          "fixed_payload_size": {
            "$ref": "#/definitions/fixed_payload_size"
          },
          "topology_info": {
            "$ref": "#/definitions/topology_info"
          }
        },
        "allOf": [
          {
            "$ref": "#/definitions/database_restrictions"
          }
        ],
        "required": [
          "namespace",
          "type",
          "device_name",
          "node_mode"
        ],
        "if": {
          "properties": {
            "node_mode": {
              "const": "master"
            }
          }
        },
        "then": {
          "required": [
            "schedule_file",
            "schedule_table_name"
          ]
        }
      },
      "lin_udp": {
        "description": "LIN-via-UDP protocol. Can be used to communicate between RemotiveBrokers.",
        "properties": {
          "database": {
            "$ref": "#/definitions/signal_db",
            "description": "Path to LIN signal database `.ldf` file."
          },
          "databases": {
            "description": "Path to LIN signal database `.ldf` file.",
            "type": "array",
            "items": {
              "$ref": "#/definitions/signal_db"
            }
          },
          "namespace": {
            "$ref": "#/definitions/namespace"
          },
          "server_host": {
            "$ref": "#/definitions/host",
            "description": "Required when using multicast to select the correct interface."
          },
          "server_port": {
            "$ref": "#/definitions/port",
            "description": "Port for receiving LIN connection to RemotiveBroker."
          },
          "target_host": {
            "$ref": "#/definitions/host",
            "description": "For multicast use, addresses in the range `224.0.0.1` to `239.255.255.255` are supported."
          },
          "target_port": {
            "$ref": "#/definitions/port",
            "description": "UDP port for RemotiveBroker to send packets to."
          },
          "node_mode": {
            "description": "Type of LIN node.",
            "enum": [
              "master",
              "slave"
            ]
          },
          "short_names": {
            "$ref": "#/definitions/short_names"
          },
          "schedule_autostart": {
            "description": "Not read: a master runs its schedule from the start.",
            "type": "boolean"
          },
          "schedule_file": {
            "description": "Path to `.ldf` file used for schedules.",
            "type": "string"
          },
          "schedule_table_name": {
            "description": "Name of the schedule table to run, as defined in the schedule `.ldf` file.",
            "type": "string"
          },
          "type": {
            "description": "Specifies a LIN-via-UDP interface.",
            "default": "udp-lin",
            "enum": [
              "udp-lin"
            ]
          },
          "public": {
            "$ref": "#/definitions/public"
          },
          "sub_type": {
            "$ref": "#/definitions/sub_type"
          },
          "sub_type_b": {
            "$ref": "#/definitions/sub_type_b"
          },
          "database_config": {
            "$ref": "#/definitions/database_config"
          },
          "fixed_payload_size": {
            "$ref": "#/definitions/fixed_payload_size"
          },
          "topology_info": {
            "$ref": "#/definitions/topology_info"
          }
        },
        "allOf": [
          {
            "$ref": "#/definitions/database_restrictions"
          }
        ],
        "required": [
          "namespace",
          "type",
          "node_mode",
          "server_port",
          "target_host",
          "target_port"
        ],
        "if": {
          "properties": {
            "node_mode": {
              "const": "master"
            }
          }
        },
        "then": {
          "required": [
            "schedule_file",
            "schedule_table_name"
          ]
        },
        "title": "LIN over UDP",
        "type": "object"
      },
      "flexray": {
        "description": "FlexRay interface.",
        "properties": {
          "config": {
            "oneOf": [
              {
                "description": "RemotiveLabs software adapter.",
                "properties": {
                  "target_host": {
                    "$ref": "#/definitions/host"
                  },
                  "target_port": {
                    "$ref": "#/definitions/port"
                  },
                  "mode": {
                    "description": "Receives from the adapter.",
                    "default": "receive",
                    "const": "receive"
                  }
                },
                "required": [
                  "target_host",
                  "target_port"
                ],
                "title": "Software adapter",
                "type": "object"
              },
              {
                "description": "Technica CAN combo hardware.",
                "properties": {
                  "hardware": {
                    "description": "What type of hardware.",
                    "default": "Technica_CM_CAN_COMBO",
                    "enum": [
                      "Technica_CM_CAN_COMBO"
                    ]
                  },
                  "target_config": {
                    "properties": {
                      "interface": {
